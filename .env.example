# =============================================================================
# CẤU HÌNH KẾT NỐI POSTGRESQL (JarsFinance & HabitFlow VN)
# =============================================================================

# Cổng chạy Express Backend API
PORT=5000

# Thông tin đăng nhập PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=jars_finance
PG_USER=postgres
PG_PASSWORD=postgres

# Hoặc chuỗi URL kết nối đầy đủ (Tùy chọn):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jars_finance?sslmode=disable
